# Copy this file to .env and change what you need:   cp .env.example .env
# .env is in .gitignore, so your keys are never committed. Never put real keys in THIS file.

DATABASE_URL=postgresql://agentforge:agentforge@localhost:5433/agentforge

# true = fake agent steps: no API keys, no cost. false = real AI calls and web search.
FAKE_LLM=true

# --- Real AI (FAKE_LLM=false) ---
# LLM_MODEL=google_genai:gemini-3.5-flash
# LLM_REQUESTS_PER_MINUTE=30   (use 4 on the Gemini free tier, which allows 5 a minute)
# GOOGLE_API_KEY=
# TAVILY_API_KEY=

# --- Tracing (optional) ---
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
