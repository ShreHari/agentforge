# Copy this file to .env and change what you need:   cp .env.example .env
# .env is in .gitignore, so your keys are never committed. Never put real keys in THIS file.

DATABASE_URL=postgresql://agentforge:agentforge@localhost:5432/agentforge

# true = fake agent steps, no API keys, no cost. Keep true until Day 2.
FAKE_LLM=true

# --- Day 2 ---
# LLM_MODEL=google_genai:gemini-3.5-flash
# LLM_REQUESTS_PER_MINUTE=4   (Gemini free tier allows 5 per minute)
# GOOGLE_API_KEY=
# TAVILY_API_KEY=

# --- Tracing (optional) ---
